# Optional: bessere Abdeckung von Betrieben OHNE Website (Google Places API, New)
GOOGLE_PLACES_API_KEY=

# Optional: Instagram-Aktivität über die offizielle Graph API (Business Discovery).
# Benötigt einen eigenen Instagram-Business-Account + Meta-App-Token.
IG_GRAPH_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# Optional: KI-Bewertung der Immobilienfotos (Flag --ki-fotos) und KI-Stichprobe im Verkaufsbericht
ANTHROPIC_API_KEY=

# Verkaufsberichte (agentur-leads report)
# Token einer internen Notion-Integration, die mit dem Board „📥 Leads“ verbunden ist
NOTION_TOKEN=
# Data-Source-ID des Leads-Boards (Standard: das 📥-Leads-Board)
NOTION_LEADS_DATENQUELLE=
# Optional: Lighthouse über PageSpeed Insights statt lokal (kostenloser Google-Cloud-Key)
PAGESPEED_API_KEY=
# Absender im Bericht
AGENTUR_NAME=GG Studios
# Optional: Modell für die KI-Stichprobe (Standard claude-opus-5-5)
KI_SUCHE_MODELL=
